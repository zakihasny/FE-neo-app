# Backend service only. Never expose these values in assets/config.js.
DATABASE_URL=postgresql://<username>:<password>@<neo-db-host>:5432/<database>?sslmode=verify-full
NATS_URL=nats://<token>@message-neo-app:4222

# Optional non-secret startup controls.
RUN_DB_MIGRATIONS=true
SEED_SAMPLE_DATA=false
